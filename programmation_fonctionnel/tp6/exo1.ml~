    ) l;;

let ajouterEmprunt liv l =
  List.map (fun livre -> 
    if livre.titre = liv.titre && livre.auteur = liv.auteur then
      { 
        titre = livre.titre; 
        auteur = livre.auteur; 
        nbEmprunts = livre.nbEmprunts + 1 
